# Placeholders only. Real values are set as Supabase secrets, never committed:
#   supabase secrets set MPESA_ENV=sandbox MPESA_BASE_URL=... MPESA_CONSUMER_KEY=... (see README → "M-Pesa setup")
MPESA_ENV=sandbox
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-daraja-passkey
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Generate with: openssl rand -hex 32
MPESA_CALLBACK_SECRET=random-64-char-hex
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically.
